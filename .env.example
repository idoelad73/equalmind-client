# Client environment. Only VITE_-prefixed vars reach the browser bundle.
# NEVER put secrets here - this file ships to every visitor.

# Base path for API calls. Left as /api, the dev server proxies to the
# Express server on :4000 and production uses the Render rewrite.
VITE_API_URL=/api

VITE_APP_NAME=Equalmind

# ---- Supabase Auth (browser) ----
# Project Settings -> API Keys. The anon / publishable key is designed to be
# public and is protected by row-level security - it is NOT the service role
# key, which must never appear here.
VITE_SUPABASE_URL=https://rdwhymcptsxzlnqzoqzq.supabase.co
VITE_SUPABASE_ANON_KEY=
